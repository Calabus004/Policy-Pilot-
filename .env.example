# Copy this file to .env and fill in each value, then never commit .env
# (it's already in .gitignore). See README.md for exactly where to get
# each key and what permissions it needs.

# OpenSanctions API key — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# Anthropic (Claude) API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Slack Incoming Webhook URL — https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Notion internal integration secret — https://www.notion.so/my-integrations
NOTION_API_KEY=

# Notion database ID — the 32-character ID in your database's URL
NOTION_DATABASE_ID=

# Optional. A SEPARATE Slack Incoming Webhook, pointed at a private channel
# only you can see (e.g. a DM to yourself, or an internal
# #compliance-ops-alerts channel a client is never invited to). Used ONLY
# to notify you privately when a run fails — never posts to the client-
# facing channel above. Set this up the same way as SLACK_WEBHOOK_URL, just
# pick a different channel when creating the webhook.
INTERNAL_ALERT_WEBHOOK_URL=
